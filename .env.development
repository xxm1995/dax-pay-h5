# 只在开发模式中被载入
VITE_PORT = 9500

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否删除console
VITE_DROP_CONSOLE = false

# 跨域代理，可以配置多个，请注意不要换行
# /api 代理到本地后端（端口 9999）
VITE_PROXY = [["/api","http://127.0.0.1:9999/"]]

# API 接口地址
# 如果没有跨域问题，直接在这里配置即可
VITE_GLOB_API_URL =

# 图片上传地址
VITE_GLOB_UPLOAD_URL =

# 图片前缀地址
VITE_GLOB_IMG_URL =

# 接口前缀（与容器/网关 nginx 的 location /api/ 对齐）
VITE_GLOB_API_URL_PREFIX = /api

# 虚拟控制台（移动端调试面板，仅开发环境生效）
VITE_V_CONSOLE = true
